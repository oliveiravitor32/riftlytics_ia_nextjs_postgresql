// Prisma 7: connection URLs live in prisma.config.ts (migrations) and in
// src/lib/db.ts (runtime, via the pg driver adapter).
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tracked player (replaces the hardcoded preset list)
model Player {
  id          String  @id @default(cuid())
  gameName    String
  tagLine     String
  region      String  @default("br1")
  displayName String
  // Photo shown on cards and ranking; null falls back to an icon
  avatarUrl   String?
  // Riot PUUID, filled on first lookup (never changes)
  puuid       String? @unique
  // Hides a player without deleting its history
  active      Boolean @default(true)
  // Matches are stored without gaps from now back to this moment (older
  // stored ones came in through a teammate and may have gaps)
  matchesSyncedUntil DateTime?

  pdlSnapshots   PDLSnapshot[]
  levelSnapshots LevelSnapshot[]
  matches        PlayerMatch[]
  duoAnalysesA DuoAnalysis[] @relation("DuoPlayer1")
  duoAnalysesB DuoAnalysis[] @relation("DuoPlayer2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameName, tagLine])
  @@map("players")
}

// Daily rank snapshot per queue (Phase 2: PDL history charts)
model PDLSnapshot {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  queueType    String // RANKED_SOLO_5x5 | RANKED_FLEX_SR
  tier         String // IRON ... CHALLENGER
  rank         String // I, II, III, IV
  leaguePoints Int
  wins         Int
  losses       Int

  // Day the snapshot belongs to (UTC): one row per player/queue/day
  snapshotDate DateTime @db.Date
  // Exact moment of the last capture that day (date + time)
  capturedAt   DateTime @default(now())

  @@unique([playerId, queueType, snapshotDate])
  @@index([playerId, queueType, snapshotDate])
  @@map("pdl_snapshots")
}

// Summoner level per player and day (Brasília), for the daily summary's
// "N levels left to 30" alert; written with the PDL snapshot
model LevelSnapshot {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  snapshotDate  DateTime @db.Date
  summonerLevel Int
  capturedAt    DateTime @default(now())

  @@id([playerId, snapshotDate])
  @@map("level_snapshots")
}

// WhatsApp bot session (Baileys auth state), one row per key, encrypted by
// the bot with BOT_SESSION_KEY. Only the bot (bot/auth-store.mjs) reads it.
model BotSession {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt

  @@map("bot_session")
}

// Game days whose WhatsApp summary was already sent: a second trigger of the
// workflow (external cron + GitHub's own schedule) must not send it twice
model SummarySent {
  day    DateTime @id @db.Date
  sentAt DateTime @default(now())

  @@map("summary_sent")
}

// Finished match (never changes): the validated Riot match-v5 payload
model Match {
  id           String   @id // Riot match id, e.g. BR1_1234567890
  queueId      Int
  gameCreation DateTime
  gameDuration Int // seconds
  data         Json

  players PlayerMatch[]

  createdAt DateTime @default(now())

  @@map("matches")
}

// A group member's line in a match: what profile lists and stats read
model PlayerMatch {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  playedAt     DateTime
  queueId      Int
  championName String
  position     String // TOP | JUNGLE | MIDDLE | BOTTOM | UTILITY | ""
  win          Boolean
  kills        Int
  deaths       Int
  assists      Int

  @@id([playerId, matchId])
  @@index([playerId, playedAt(sort: Desc)])
  @@map("player_matches")
}

// AI duo compatibility analysis (Phase 3)
model DuoAnalysis {
  id        String @id @default(cuid())
  player1Id String
  player1   Player @relation("DuoPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id String
  player2   Player @relation("DuoPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  compatibilityScore Float // 1-10
  strengths          String
  weaknesses         String
  recommendations    String

  cachedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([player1Id, player2Id])
  @@map("duo_analyses")
}

// AI matchup tips (Gemini), one row per champion pair. The pair is stored in
// alphabetical order (champA < champB) so A×B and B×A share one answer.
// Regenerated when expiresAt passes (2 months), on the next request.
model MatchupTip {
  champA    String
  champB    String
  // MatchupTip (src/lib/matchup.ts): "a" = champA, "b" = champB
  tip       Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@id([champA, champB])
  @@map("matchup_tips")
}

// Who may post in the Resenha: an allowlist, never a blocklist. Anyone can
// sign in with Google and read; only an email listed here can post. Rows are
// added by hand (Prisma Studio / Supabase dashboard), never by the app.
model PostingAllowlist {
  // Lowercase, as Google reports it
  email     String   @id
  note      String?
  // Can delete anyone's post in the Resenha (moderation)
  admin     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("posting_allowlist")
}

// Resenha (group chat). LGPD: no email is stored here; the author is the
// Supabase user id, and every personal or written field is encrypted by the
// app (AES-256-GCM, RESENHA_KEY; src/lib/resenha-crypto.ts). Deleting a post
// removes the row.
model ResenhaAuthor {
  // Supabase Auth user id
  id        String        @id
  // Encrypted: Google name and photo URL, refreshed on every post
  name      String
  avatarUrl String?
  updatedAt DateTime      @updatedAt
  posts     ResenhaPost[]

  @@map("resenha_authors")
}

model ResenhaPost {
  id        String        @id @default(cuid())
  authorId  String
  author    ResenhaAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Encrypted message text
  body      String
  createdAt DateTime      @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("resenha_posts")
}
